rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────

    // Ensure the request is from an authenticated user
    function isAuthed() {
      return request.auth != null;
    }

    // Ensure the write is for the authenticated user's own data
    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // Validate that a string field is non-empty and within length limits
    function validString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    // Validate a score document payload
    function validScorePayload() {
      let data = request.resource.data;
      return
        validString(data.uid, 128) &&
        validString(data.name, 24) &&
        data.totalTries is int && data.totalTries >= 0 && data.totalTries <= 30 &&
        data.totalTime is int && data.totalTime >= 0 &&
        data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 10 &&
        data.matchesWon is int && data.matchesWon >= 0 && data.matchesWon <= data.matchesPlayed &&
        validString(data.date, 12) &&
        data.flag is string && data.flag.size() <= 10;
    }

    // Validate wins document payload
    function validWinsPayload() {
      let data = request.resource.data;
      return
        validString(data.uid, 128) &&
        validString(data.name, 24) &&
        data.wins is int && data.wins >= 0 &&
        data.flag is string && data.flag.size() <= 10;
    }

    // ── Daily Scores ─────────────────────────────────────────
    // Document ID format: "{YYYY-M-DD}_{UID}"
    match /scores/{docId} {
      // Anyone can read leaderboard entries
      allow read: if true;

      // Only the authenticated user can write their own score
      // The docId must match "{date}_{uid}" where uid = request.auth.uid
      allow create, update: if
        isAuthed() &&
        request.auth.uid == request.resource.data.uid &&
        docId == request.resource.data.date + "_" + request.auth.uid &&
        validScorePayload();

      // No deletes
      allow delete: if false;
    }

    // ── Quick Challenge Wins ──────────────────────────────────
    // Document ID = UID
    match /wins_quick/{uid} {
      allow read: if true;
      allow create, update: if
        isOwner(uid) &&
        request.resource.data.uid == uid &&
        validWinsPayload() &&
        // Prevent wins from decreasing (anti-cheat)
        (!exists(/databases/$(database)/documents/wins_quick/$(uid)) ||
         request.resource.data.wins >= resource.data.wins);
      allow delete: if false;
    }

    // ── Friend Challenge Wins ─────────────────────────────────
    // Document ID = UID
    match /wins_friend/{uid} {
      allow read: if true;
      allow create, update: if
        isOwner(uid) &&
        request.resource.data.uid == uid &&
        validWinsPayload() &&
        // Prevent wins from decreasing (anti-cheat)
        (!exists(/databases/$(database)/documents/wins_friend/$(uid)) ||
         request.resource.data.wins >= resource.data.wins);
      allow delete: if false;
    }

    // ── Deny all other reads/writes ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
